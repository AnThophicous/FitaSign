{
  "name": "fitasign",
  "productName": "FitaSign",
  "version": "0.1.0-beta.1",
  "description": "Editor de interfaces Roblox com exportação Luau e MCP local.",
  "license": "Apache-2.0",
  "author": "Brenno Leon and FitaSign contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnThophicous/FitaSign.git"
  },
  "homepage": "https://github.com/AnThophicous/FitaSign",
  "bugs": {
    "url": "https://github.com/AnThophicous/FitaSign/issues"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test",
    "check:core": "tsc --noEmit && npm run lint && npm test && node scripts/build.mjs",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "mcp": "node dist/mcp/stdio.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "io.fitasign.desktop",
    "productName": "FitaSign",
    "copyright": "Copyright © 2026 FitaSign contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE",
      "AGENTS.md",
      "skills/**/*",
      "docs/mcp.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist/mcp/stdio.cjs",
        "to": "mcp/stdio.cjs"
      },
      {
        "from": "AGENTS.md",
        "to": "AGENTS.md"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "*.md"
        ]
      },
      {
        "from": "dist/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "artifactName": "FitaSign-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FitaSign-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "FitaSign-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "Brenno Leon <273256966+AnThophicous@users.noreply.github.com>"
    }
  }
}
